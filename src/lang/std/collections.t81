// src/lang/std/collections.t81
// Collection utilities.

// Deterministic Vector helpers.
// NOTE: Generic function wrappers are not supported yet by the current parser.

fn len(v: Vector[i32]) -> i32 {
    return std.collections.len(v);
}

fn is_empty(v: Vector[i32]) -> bool {
    return std.collections.is_empty(v);
}

fn first(v: Vector[i32]) -> i32 {
    return std.collections.first(v);
}

fn last(v: Vector[i32]) -> i32 {
    return std.collections.last(v);
}

fn push(v: Vector[i32], value: i32) -> Vector[i32] {
    return std.collections.push(v, value);
}

fn pop(v: Vector[i32]) -> Vector[i32] {
    return std.collections.pop(v);
}
