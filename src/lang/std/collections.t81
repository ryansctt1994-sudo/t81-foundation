// src/lang/std/collections.t81
// Collection utilities.

// Deterministic Vector helpers.
fn len[T](v: Vector[T]) -> i32 {
    return std.collections.len(v);
}

fn is_empty[T](v: Vector[T]) -> bool {
    return std.collections.is_empty(v);
}

fn first[T](v: Vector[T]) -> T {
    return std.collections.first(v);
}

fn last[T](v: Vector[T]) -> T {
    return std.collections.last(v);
}

fn push[T](v: Vector[T], value: T) -> Vector[T] {
    return std.collections.push(v, value);
}

fn pop[T](v: Vector[T]) -> Vector[T] {
    return std.collections.pop(v);
}

// Deterministic container-handle constructors for roadmap modules.
fn list() -> Vector[T81String] {
    return std.collections.list();
}

fn map() -> Vector[T81String] {
    return std.collections.map();
}

fn map_size(m: Vector[T81String]) -> i32 {
    return std.collections.map_size(m);
}

fn map_has(m: Vector[T81String], key: T81String) -> bool {
    return std.collections.map_has(m, key);
}

fn map_put(m: Vector[T81String], key: T81String, value: T81String) -> Vector[T81String] {
    return std.collections.map_put(m, key, value);
}

fn map_get(m: Vector[T81String], key: T81String) -> Option[T81String] {
    return std.collections.map_get(m, key);
}

fn map_remove(m: Vector[T81String], key: T81String) -> Vector[T81String] {
    return std.collections.map_remove(m, key);
}

fn map_keys(m: Vector[T81String]) -> Vector[T81String] {
    return std.collections.map_keys(m);
}

fn set() -> Vector[T81String] {
    return std.collections.set();
}

fn set_size(s: Vector[T81String]) -> i32 {
    return std.collections.set_size(s);
}

fn set_has(s: Vector[T81String], key: T81String) -> bool {
    return std.collections.set_has(s, key);
}

fn set_add(s: Vector[T81String], key: T81String) -> Vector[T81String] {
    return std.collections.set_add(s, key);
}

fn set_remove(s: Vector[T81String], key: T81String) -> Vector[T81String] {
    return std.collections.set_remove(s, key);
}

fn tree() -> Vector[T81String] {
    return std.collections.tree();
}

fn graph() -> Vector[T81String] {
    return std.collections.graph();
}

fn graph_edge_count(g: Vector[T81String]) -> i32 {
    return std.collections.graph_edge_count(g);
}

fn graph_has_edge(g: Vector[T81String], from: T81String, to: T81String) -> bool {
    return std.collections.graph_has_edge(g, from, to);
}

fn graph_add_edge(g: Vector[T81String], from: T81String, to: T81String) -> Vector[T81String] {
    return std.collections.graph_add_edge(g, from, to);
}

fn graph_remove_edge(g: Vector[T81String], from: T81String, to: T81String) -> Vector[T81String] {
    return std.collections.graph_remove_edge(g, from, to);
}
