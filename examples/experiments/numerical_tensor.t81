    // let v_sum: i32 = v1[0] + v2[0];
    // print("Sum of first elements: "); print(v_sum);

    // 2. Tensor (Dynamic / Generic Tensor via stdlib)
    print("--- Tensor (Dynamic) ---");
    // Construct tensor from list
    // std.tensor.from_list takes Vector[i32]
    // We need to construct a Vector[i32] first.
    // Assuming we can construct it or push to it.
    // let vec_vals: Vector[i32] = std.collections.vector(); // Not exposed?
