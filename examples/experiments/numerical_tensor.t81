// experiments/numerical_tensor.t81
// Exploration of Numerical Tensor Layer: T81Vector, T81Matrix, T81Tensor
// Note: Based on demos, T81Vector[T, N] syntax is used, but stdlib has Tensor type.

fn numerical_tensor_demo() -> i32 {
    print("=== Numerical Tensor Layer ===");

    // 1. T81Vector (Fixed size vector)
    print("--- T81Vector ---");
    // let v1: T81Vector[i32, 2] = [1, 2];
