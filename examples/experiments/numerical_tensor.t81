    let t1: Tensor = std.tensor.from_list([1, 2, 3, 4]);
    let t2: Tensor = std.tensor.from_list([5, 6, 7, 8]);

    // Tensor addition
    let t_sum: Tensor = std.tensor.vec_add(t1, t2);
    print("Tensor Sum (t1 + t2): ");
