# T81 Foundation — Canonical .gitignore (2026 edition)

# ── Build artifacts ─────────────────────────────────────────
build*/
cmake-build-*/
out/
bin/
obj/
dist/
Debug/
Release/
*.dir/
cmake_install.cmake
CMakeCache.txt
CMakeFiles/
CTestTestfile.cmake
Testing/
compile_commands.json   # ← remove or negate if you want it tracked
!compile_commands.json  # ← recommended for clangd/ccls

*.o *.obj *.a *.lib *.so *.dylib *.dll *.exe *.pdb *.ilk *.exp
*.gcda *.gcno *.gcov *.profraw *.profdata *.cov

# Repo-specific binaries & test outputs
/t81
axion_*
canonfs_*
llama*
ir_inspector
tisc_base81
*_demo
*_test
*_trace_test
*_trace_demo
weights_*

# ── Package managers ────────────────────────────────────────
.vcpkg/
vcpkg/
conan*

# ── Python / Jupyter ────────────────────────────────────────
__pycache__/
*.py[cod] *.pyc *.pyo *.pyd
*.egg-info/ dist/ build/ .egg
.venv/ venv/ env/ .env
.pytest_cache/ .coverage coverage.xml htmlcov/
.mypy_cache/ .ruff_cache/ .dmypy.json
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# ── Docs / generated ────────────────────────────────────────
docs/_site/
docs/.docusaurus/
docs/api/
pdf/output/
pdf/*.aux pdf/*.log pdf/*.out pdf/*.toc

# ── Editors / OS junk ───────────────────────────────────────
.vscode/* !.vscode/settings.json !.vscode/launch.json !.vscode/tasks.json
.idea/
*~
.DS_Store 
Thumbs.db

# ── Legacy hanoivm ──────────────────────────────────────────
legacy/hanoivm/**/*.{c,h,tex,dvi,pdf,log,aux,toc,idx,out}
legacy/hanoivm/**/target/

# ── Bazel leftovers ─────────────────────────────────────────
MODULE.bazel WORKSPACE WORKSPACE.bzlmod bazel-* .bazelrc

# Deliberately tracked: source files, compile_commands.json (for IDEs), Cargo.lock in libs, etc.
