{
    "name": "vscode-t81",
    "displayName": "T81 Foundation Support",
    "description": "Syntax highlighting and support for T81Lang.",
    "version": "0.1.0",
    "publisher": "t81-foundation",
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [{
            "id": "t81",
            "aliases": ["T81", "t81", "T81Lang"],
            "extensions": [".t81"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "t81",
            "scopeName": "source.t81",
            "path": "./syntaxes/t81.tmLanguage.json"
        }]
    }
}
