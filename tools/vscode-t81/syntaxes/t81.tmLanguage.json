{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "T81Lang",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#types"
        },
        {
            "include": "#functions"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.t81",
                    "begin": "//",
                    "end": "$"
                },
                {
                    "name": "comment.block.t81",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "keywords": {
            "patterns": [{
                "name": "keyword.control.t81",
                "match": "\\b(if|else|loop|match|return|let|var|fn|record|enum|try|catch|match)\\b"
            }, {
                "name": "keyword.other.t81",
                "match": "@\\b(tier|effect|bounded|contract)\\b"
            }]
        },
        "strings": {
            "name": "string.quoted.double.t81",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.t81",
                    "match": "\\\\."
                }
            ]
        },
        "numbers": {
            "patterns": [{
                "name": "constant.numeric.ternary.t81",
                "match": "\\b[012t]+\\b"
            }, {
                "name": "constant.numeric.decimal.t81",
                "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
            }]
        },
        "types": {
            "patterns": [{
                "name": "entity.name.type.t81",
                "match": "\\b(T81Int|T81Float|T81Fraction|Symbol|Vector|Matrix|Tensor|Option|Result)\\b"
            }]
        },
        "functions": {
            "patterns": [{
                "name": "entity.name.function.t81",
                "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
            }]
        }
    },
    "scopeName": "source.t81"
}
