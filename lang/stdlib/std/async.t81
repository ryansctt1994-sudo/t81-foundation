// lang/stdlib/std/async.t81
// Deterministic concurrency primitives.

fn yield() -> void {
    std.async.yield();
}

fn sleep(duration: T81Float) -> void {
    std.async.sleep(duration);
}

fn thread() -> T81String {
    return std.async.thread();
}

fn promise() -> T81String {
    return std.async.promise();
}
