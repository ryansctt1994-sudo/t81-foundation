// lang/stdlib/std/sys.t81
// System interactions.

fn exit(code: i32) -> void {
    std.sys.exit(code);
}

fn time() -> T81Float {
    return std.sys.time();
}

fn entropy() -> i32 {
    return std.sys.entropy();
}

fn proof() -> T81String {
    return std.sys.proof();
}

fn reflect() -> void {
    std.sys.reflect();
}
