fn test_t81int_overflow() -> i32 {
    let max_i32: i32 = 2147483647;
    let min_i32: i32 = -2147483648;

    let over: i32 = max_i32 + 1;
    let under: i32 = min_i32 - 1;

    print("Max i32 + 1:");
    print(over);
    print("Min i32 - 1:");
    print(under);

    return 0;
}

fn test_bigint_growth() -> i32 {
    let base: T81BigInt = 1t81;
    var curr: T81BigInt = base;
    var i: i32 = 0;
    while (i < 100) {
        curr = curr * 2t81;
        i = i + 1;
    }
    print("BigInt 2^100:");
    print(curr);

    let sub: T81BigInt = curr - 1t81;
    print("BigInt 2^100 - 1:");
    print(sub);

    return 0;
}

fn test_fraction_canonicalization() -> i32 {
    let f1: T81Fraction = std.math.fraction.from_int(2);
    let f2: T81Fraction = std.math.fraction.from_int(4);
    let half: T81Fraction = std.math.fraction.div(f1, f2);

    print("2/4 canonicalized:");
    print(half);

    let f3: T81Fraction = std.math.fraction.from_int(3);
    let f4: T81Fraction = std.math.fraction.mul(f2, f3);
    let third: T81Fraction = std.math.fraction.div(f1, f4);
    print("2/12 canonicalized:");
    print(third);

    return 0;
}

fn test_fixed_precision() -> i32 {
    let f: T81Fixed = T81Fixed(100);
    print("Fixed 100:");
    print(f);

    return 0;
}

fn test_float_boundaries() -> i32 {
    let pi: T81Float = 3.14159t81;
    let huge: T81Float = 100000000000000000000.0t81;
    let tiny: T81Float = 0.00000000000000000001t81;

    print("Pi:");
    print(pi);
    print("Huge:");
    print(huge);
    print("Tiny:");
    print(tiny);

    let sum: T81Float = huge + tiny;
    print("Huge + Tiny:");
    print(sum);

    return 0;
}

fn main() -> i32 {
    print("--- Phase 1: Numeric Boundary Assault ---");
    test_t81int_overflow();
    test_bigint_growth();
    test_fraction_canonicalization();
    test_fixed_precision();
    test_float_boundaries();
    print("--- End Phase 1 ---");
    return 0;
}
