fn main() -> i32 {
  let b: T81String = std.bytes.concat("al", "pha");
  print(std.bytes.len(b));
  print(std.bytes.is_empty(""));
  print(std.bytes.is_empty("x"));
  print(std.bytes.starts_with(b, "al"));
  print(std.bytes.ends_with(b, "ha"));
  print(std.bytes.contains(b, "lp"));
  print(std.bytes.index_of(b, "ph"));
  print(std.bytes.index_of(b, "zz"));
  print(std.bytes.replace(b, "ph", "zz"));
  return 0;
}
