fn main() -> i32 {
    let empty_set: Vector[T81String] = std.collections.set();
    print(std.collections.set_size(empty_set));
    print(std.collections.set_has(empty_set, "city"));

    let staged_set: Vector[T81String] = ["city", "lang", "city"];
    print(std.collections.set_size(staged_set));
    print(std.collections.set_has(staged_set, "city"));
    print(std.collections.set_has(staged_set, "lang"));
    print(std.collections.set_has(staged_set, "missing"));
    return 0;
}
